# Copia este archivo como .env y llena tus datos. El .env NUNCA se sube a GitHub.
# Puedes pegar tal cual las variables que te da Clever Cloud (MYSQL_ADDON_*).
MYSQL_ADDON_HOST=
MYSQL_ADDON_PORT=3306
MYSQL_ADDON_DB=
MYSQL_ADDON_USER=
MYSQL_ADDON_PASSWORD=

# 1 = muestra errores detallados (solo para pruebas)
APP_DEBUG=0
APP_TIMEZONE=America/Guatemala
# 1 cuando el sitio está detrás de un proxy (Render). En tu Mac déjalo en 0.
TRUST_PROXY=0
# disk = fotos en la carpeta uploads/ · db = fotos dentro de MySQL (Render)
IMAGES_STORAGE=disk

# Horas sin actividad antes de cerrar la sesión del panel
SESSION_HOURS=8
