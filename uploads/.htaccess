# Solo imágenes: nunca ejecutar scripts aquí
Options -Indexes
<FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh|html?)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
